          "path"
        ],
        "properties": {
          "path": {
            "description": "Path to forjar.yaml",
            "type": "string"
          }
        }
      },
      "output_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "LintOutput",
        "description": "MCP lint handler output.",
        "type": "object",
        "required": [
          "error_count",
          "warning_count",
          "warnings"
        ],
        "properties": {
          "error_count": {
            "description": "Total number of errors.",
            "type": "integer",
            "format": "uint",
            "minimum": 0.0
          },
          "warning_count": {
            "description": "Total number of warnings.",
            "type": "integer",
            "format": "uint",
            "minimum": 0.0
          },
          "warnings": {
            "description": "Lint warning messages.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "forjar_graph",
      "description": "Generate resource dependency graph (format: mermaid or dot only)",
      "input_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "GraphInput",
        "description": "MCP graph handler input.",
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "format": {
            "description": "Output format: \"mermaid\" (default) or \"dot\". Any other value is an error — \"ascii\" and \"svg\" exist on the CLI only, and an unrecognised value is rejected exactly as `forjar graph --format` rejects it (GH-212).",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Path to forjar.yaml",
            "type": "string"
          }
        }
      },
      "output_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "GraphOutput",
        "description": "MCP graph handler output.",
        "type": "object",
        "required": [
          "format",
          "graph"
        ],
        "properties": {
          "format": {
            "description": "The format ACTUALLY rendered — always one of \"mermaid\" or \"dot\", never an echo of an unsupported request (GH-212).",
            "type": "string"
          },
          "graph": {
            "description": "Rendered dependency graph.",
            "type": "string"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "forjar_show",
      "description": "Show fully resolved config with templates expanded",
      "input_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "ShowInput",
        "description": "MCP show handler input.",
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "description": "Path to forjar.yaml",
            "type": "string"
          },
          "resource": {
            "description": "Show specific resource only",
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "output_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "ShowOutput",
        "description": "MCP show handler output.",
        "type": "object",
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "description": "Parsed config as JSON value."
          }
        }
      },
      "annotations": {
