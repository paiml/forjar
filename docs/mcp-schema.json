    {
      "name": "forjar_status",
      "description": "Show current state from lock files",
      "input_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "StatusInput",
        "description": "MCP status handler input.",
        "type": "object",
        "properties": {
          "machine": {
            "description": "Filter to specific machine",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "GH-208: path to the project's forjar.yaml. Optional for backward compatibility, but without it the tool cannot know WHICH project it is being asked about and falls back to `./state` relative to the server's cwd — which for an MCP stdio server is chosen by the client and is arbitrary.",
            "type": [
              "string",
              "null"
            ]
          },
          "state_dir": {
            "description": "State directory (default: \"state\")",
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "output_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "StatusOutput",
        "description": "MCP status handler output.",
        "type": "object",
        "required": [
          "machines"
        ],
        "properties": {
          "machines": {
            "description": "Per-machine status entries.",
            "type": "array",
            "items": {
              "$ref": "#/definitions/MachineStatusOutput"
            }
          }
        },
        "definitions": {
          "MachineStatusOutput": {
            "description": "Status summary for a single machine.",
            "type": "object",
            "required": [
              "name",
              "resource_count"
            ],
            "properties": {
              "name": {
                "description": "Machine name.",
                "type": "string"
              },
              "resource_count": {
                "description": "Number of managed resources.",
                "type": "integer",
                "format": "uint",
                "minimum": 0.0
              }
            }
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "forjar_trace",
      "description": "View trace provenance data from apply runs",
      "input_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "TraceInput",
        "description": "MCP trace handler input.",
        "type": "object",
        "properties": {
          "machine": {
            "description": "Filter to specific machine",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "GH-208: path to the project's forjar.yaml. Optional for backward compatibility, but without it the tool cannot know WHICH project it is being asked about and falls back to `./state` relative to the server's cwd — which for an MCP stdio server is chosen by the client and is arbitrary.",
            "type": [
              "string",
              "null"
            ]
          },
          "state_dir": {
            "description": "State directory (default: \"state\")",
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "output_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "TraceOutput",
