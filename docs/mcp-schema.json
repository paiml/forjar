{
  "schema_version": "1.0",
  "server": "forjar-mcp",
  "version": "1.20.1",
  "tool_count": 9,
  "tools": [
    {
      "name": "forjar_validate",
      "description": "Validate a forjar.yaml configuration file",
      "input_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "ValidateInput",
        "description": "MCP validate handler input.",
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "description": "Path to forjar.yaml",
            "type": "string"
          }
        }
      },
      "output_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "ValidateOutput",
        "description": "MCP validate handler output.",
        "type": "object",
        "required": [
          "errors",
          "machine_count",
          "resource_count",
          "valid"
        ],
        "properties": {
          "errors": {
            "description": "Validation error messages.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "machine_count": {
            "description": "Number of machines in the config.",
            "type": "integer",
            "format": "uint",
            "minimum": 0.0
          },
          "resource_count": {
            "description": "Number of resources in the config.",
            "type": "integer",
            "format": "uint",
            "minimum": 0.0
          },
          "valid": {
            "description": "Whether the config is valid.",
            "type": "boolean"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "forjar_plan",
      "description": "Show execution plan for infrastructure changes",
      "input_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "PlanInput",
        "description": "MCP plan handler input.",
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "description": "Path to forjar.yaml",
            "type": "string"
          },
          "resource": {
            "description": "Filter to a specific resource. The counts below describe the FILTERED set, and an id that is not in the config is an error (GH-214).",
            "type": [
              "string",
              "null"
            ]
          },
          "state_dir": {
            "description": "State directory (default: \"state\")",
            "type": [
              "string",
              "null"
            ]
          },
          "tag": {
            "description": "Filter by tag",
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "output_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "PlanOutput",
        "description": "MCP plan handler output.",
        "type": "object",
        "required": [
          "changes",
          "lock_relative",
          "to_create",
          "to_destroy",
          "to_update",
          "unchanged",
          "unconsulted_observations"
        ],
        "properties": {
          "changes": {
            "description": "Planned resource changes.",
            "type": "array",
            "items": {
              "$ref": "#/definitions/PlannedChangeOutput"
            }
          },
          "disclosure": {
            "description": "The prose form of the disclosure, present iff `unconsulted_observations` is non-zero. Names `forjar drift` as the command that can answer the question this report cannot.",
            "type": [
              "string",
              "null"
            ]
          },
          "lock_relative": {
            "description": "forjar#342: this report compares the config to the LOCK and contacts no machine. Always true — it is a statement of the quantifier, not a mode.",
            "type": "boolean"
          },
          "to_create": {
            "description": "Count of resources to create.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0.0
          },
          "to_destroy": {
            "description": "Count of resources to destroy.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0.0
          },
          "to_update": {
            "description": "Count of resources to update.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0.0
          },
          "unchanged": {
            "description": "Count of unchanged resources.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0.0
          },
          "unconsulted_observations": {
            "description": "How many locked resources carry state observed on a target that this plan did not consult. Always present, including at zero, so a consumer can tell \"nothing observed\" from \"an older binary\".",
            "type": "integer",
            "format": "uint",
            "minimum": 0.0
          }
        },
        "definitions": {
          "PlannedChangeOutput": {
            "description": "A single planned resource change.",
            "type": "object",
            "required": [
              "action",
              "description",
              "machine",
              "resource_id"
            ],
            "properties": {
              "action": {
                "description": "Planned action (create, update, destroy).",
                "type": "string"
              },
              "description": {
                "description": "Human-readable change description.",
                "type": "string"
              },
              "machine": {
                "description": "Target machine name.",
                "type": "string"
              },
              "resource_id": {
                "description": "Resource identifier.",
                "type": "string"
              }
            }
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "forjar_drift",
      "description": "Detect configuration drift from desired state",
      "input_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "DriftInput",
        "description": "MCP drift handler input.",
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "machine": {
            "description": "Filter to specific machine",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Path to forjar.yaml",
            "type": "string"
          },
          "state_dir": {
            "description": "State directory (default: \"state\")",
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "output_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "DriftOutput",
        "description": "MCP drift handler output.",
        "type": "object",
        "required": [
          "drifted",
          "findings"
        ],
        "properties": {
          "drifted": {
            "description": "Whether any drift was detected.",
            "type": "boolean"
          },
          "findings": {
            "description": "Individual drift findings.",
            "type": "array",
            "items": {
              "$ref": "#/definitions/DriftFindingOutput"
            }
          },
          "unchecked": {
            "description": "GH-208: machines that could NOT be compared (no state recorded yet), so a caller can distinguish \"clean\" from \"not looked at\". Previously an uncomparable machine simply contributed no findings and the tool answered `drifted: false`, which reads as a clean bill of health for a machine that was never inspected.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "definitions": {
          "DriftFindingOutput": {
            "description": "A single drift finding for a resource.",
            "type": "object",
            "required": [
              "actual_hash",
              "detail",
              "expected_hash",
              "resource"
            ],
            "properties": {
              "actual_hash": {
                "description": "Actual content hash found.",
                "type": "string"
              },
              "detail": {
                "description": "Drift detail message.",
                "type": "string"
              },
              "expected_hash": {
                "description": "Expected content hash.",
                "type": "string"
              },
              "resource": {
                "description": "Resource that drifted.",
                "type": "string"
              }
            }
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "forjar_lint",
