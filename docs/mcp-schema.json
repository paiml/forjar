          }
        },
        "definitions": {
          "TraceSpanOutput": {
            "description": "A single trace span.",
            "type": "object",
            "required": [
              "action",
              "duration_us",
              "exit_code",
              "logical_clock",
              "machine",
              "name",
              "resource_type",
              "span_id",
              "start_time",
              "trace_id"
            ],
            "properties": {
              "action": {
                "description": "Action performed (create, update, destroy).",
                "type": "string"
              },
              "content_hash": {
                "description": "Content hash after action.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "duration_us": {
                "description": "Duration in microseconds.",
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              },
              "exit_code": {
                "description": "Process exit code.",
                "type": "integer",
                "format": "int32"
              },
              "logical_clock": {
                "description": "Lamport logical clock value.",
                "type": "integer",
                "format": "uint64",
                "minimum": 0.0
              },
              "machine": {
                "description": "Machine the span ran on.",
                "type": "string"
              },
              "name": {
                "description": "Span operation name.",
                "type": "string"
              },
              "parent_span_id": {
                "description": "Parent span for nesting.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "resource_type": {
                "description": "Resource type (package, file, service, etc.).",
                "type": "string"
              },
              "span_id": {
                "description": "Unique span identifier.",
                "type": "string"
              },
              "start_time": {
                "description": "ISO 8601 start timestamp.",
                "type": "string"
              },
              "trace_id": {
                "description": "Unique trace identifier.",
                "type": "string"
              }
            }
          }
        }
      },
