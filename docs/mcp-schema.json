        "title": "AnomalyInput",
        "description": "MCP anomaly handler input.",
        "type": "object",
        "properties": {
          "machine": {
            "description": "Filter to specific machine",
            "type": [
              "string",
              "null"
            ]
          },
          "min_events": {
            "description": "Minimum events to consider a resource (default: 3)",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint",
            "minimum": 0.0
          },
          "path": {
            "description": "GH-208: path to the project's forjar.yaml. Optional for backward compatibility, but without it the tool cannot know WHICH project it is being asked about and falls back to `./state` relative to the server's cwd — which for an MCP stdio server is chosen by the client and is arbitrary.",
            "type": [
              "string",
              "null"
            ]
          },
          "state_dir": {
            "description": "State directory (default: \"state\")",
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "output_schema": {
